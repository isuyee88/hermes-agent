# Hermes Agent Modal deployment configuration
#
# Store the real values in a Modal Secret, for example:
#   modal secret create custom-secret ^
#     DEFAULT_MODEL=openrouter/free ^
#     OPENROUTER_API_KEY=... ^
#     TELEGRAM_BOT_TOKEN=... ^
#     TELEGRAM_WEBHOOK_SECRET=... ^
#     WEBHOOK_SECRET=...

# Modal deployment resources
HERMES_MODAL_APP_NAME=hermes-agent
HERMES_MODAL_SECRET_NAME=custom-secret
HERMES_MODAL_VOLUME_NAME=hermes-agent-data
HERMES_MODAL_DATA_DIR=/data/hermes
HERMES_MODAL_CONFIG_SOURCE=/root/config.modal.yaml
HERMES_MODAL_SYNC_CONFIG=true

# Hermes runtime
HERMES_HOME=/data/hermes-home
DEFAULT_MODEL=openrouter/free
HERMES_MAX_TURNS=16
AGENT_MAX_TOKENS=8192
HERMES_SESSION_ROUTE_TTL_SECONDS=7200
TERMINAL_ENV=local
HERMES_MODAL_TERMINAL_ENV=local

# Provider config
# Prefer Hermes/OpenRouter/OpenAI-compatible env vars over hard-coded endpoints.
HERMES_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=replace_me
OPENROUTER_BROADCAST_ENABLED=false
OPENROUTER_BROADCAST_PRIVACY_MODE=true
HERMES_INFERENCE_USE_CLOUDFLARE_AI_GATEWAY=false
CLOUDFLARE_AI_GATEWAY_BASE_URL=https://gateway.ai.cloudflare.com/v1/d1215a30b84b673ef0367010b0e78c10/affiliate-manager
CLOUDFLARE_AI_GATEWAY_API_KEY=
HERMES_CLOUDFLARE_AI_GATEWAY_PROVIDERS=openrouter,nvidia
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ROUTE_GENERAL=affiliate-general
CLOUDFLARE_AI_GATEWAY_ROUTE_CODING=affiliate-coding
CLOUDFLARE_AI_GATEWAY_ROUTE_CREATIVE=affiliate-creative
CLOUDFLARE_AI_GATEWAY_ROUTE_IMAGE=affiliate-image
CLOUDFLARE_AI_GATEWAY_CACHE_MODE=smart
CLOUDFLARE_AI_GATEWAY_CACHE_TTL_SECONDS=120
CLOUDFLARE_AI_GATEWAY_USE_PROMPT_CACHE_KEY=false
CLOUDFLARE_AI_GATEWAY_REQUEST_TIMEOUT_MS=12000
CLOUDFLARE_AI_GATEWAY_MAX_ATTEMPTS=2
CLOUDFLARE_AI_GATEWAY_RETRY_DELAY_MS=250
CLOUDFLARE_AI_GATEWAY_BACKOFF=exponential
SUPERMEMORY_API_KEY=replace_me
# Optional: override the default "hermes" container tag used by the official
# Hermes supermemory memory provider integration.
# SUPERMEMORY_CONTAINER_TAG=hermes

# Optional toolset tuning
# HERMES_ENABLED_TOOLSETS=web,file,terminal,todo,memory,session_search
HERMES_DISABLED_TOOLSETS=messaging,rl,voice

# Official integrations
# Enable project-local plugins from ./.hermes/plugins/ (official plugin system).
HERMES_ENABLE_PROJECT_PLUGINS=true

# Web search backends (official integrations docs: Firecrawl / Parallel / Tavily / Exa)
# FIRECRAWL_API_KEY=
# FIRECRAWL_API_URL=
# PARALLEL_API_KEY=
# TAVILY_API_KEY=
# EXA_API_KEY=

# Browser integrations
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSER_USE_API_KEY=
# FIRECRAWL_BROWSER_SESSION_TTL=300
# Modal runtime auto-starts a local Camofox server when this points at localhost.
CAMOFOX_URL=http://127.0.0.1:9377

# Home Assistant integration
# HASS_URL=https://homeassistant.example.com
# HASS_TOKEN=

# OpenAI-compatible API server integration
# API_SERVER_ENABLED=false
# API_SERVER_KEY=
# API_SERVER_PORT=8000
# API_SERVER_HOST=127.0.0.1

# Public webhook protection
# Used by the generic /invoke endpoint as Bearer auth.
WEBHOOK_SECRET=replace_me

# Telegram webhook support
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_ALLOWED_USERS=123456789
TELEGRAM_WEBHOOK_SECRET=replace_me
HERMES_PUBLIC_BASE_URL=https://isuyee88--hermes-agent-web-app.modal.run
TELEGRAM_WEBHOOK_AUTO_SYNC=true
TELEGRAM_SEND_ACK=false

# QQ official bot webhook support
QQ_APP_ID=replace_me
QQ_APP_SECRET=replace_me
# Optional:
# QQ_ALLOWED_USERS=
# QQ_HOME_CHANNEL=c2c:USER_OPENID

# Feishu / Lark support
FEISHU_APP_ID=replace_me
FEISHU_APP_SECRET=replace_me
# Optional:
# FEISHU_DOMAIN=feishu
# FEISHU_CONNECTION_MODE=webhook
# FEISHU_ENCRYPT_KEY=
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_BITABLE_APP_TOKEN=
# FEISHU_BITABLE_WIKI_TOKEN=
# FEISHU_BITABLE_TABLE_ID=
# FEISHU_MODEL_REGISTRY_MIRROR_ENABLED=false
# FEISHU_MODEL_REGISTRY_SYNC_INTERVAL_SECONDS=1800
# FEISHU_STARTUP_SCHEMA_RECHECK_SECONDS=21600
# FEISHU_ALLOWED_USERS=
# FEISHU_HOME_CHANNEL=
# HERMES_FEISHU_RESOLVE_SENDER_NAMES=false
# HERMES_FEISHU_MENU_OPEN_BY_OPEN_ID=true
# HERMES_FEISHU_TOOL_CAPABILITIES=docs,sheets,bitable,contacts,messages,files,model_registry
# HERMES_FEISHU_DEFAULT_WORKSPACE=

# Modal maintenance heartbeat
# HERMES_MODAL_MAINTENANCE_HEARTBEAT_ENABLED=true
# HERMES_MODAL_MAINTENANCE_HEARTBEAT_MINUTES=5
# HERMES_MODAL_CHAT_QUEUE_SPAWN_COOLDOWN_SECONDS=15
# HERMES_MODAL_CHAT_QUEUE_WORKER_MEMORY_MB=3072
# HERMES_MODAL_CHAT_QUEUE_WORKER_CPU=1
# Cost-first default: keep Feishu snapshots off unless a controlled A/B test
# proves a specific snapshot materially improves ACK without raising idle cost.
# HERMES_MODAL_WEB_APP_MEMORY_SNAPSHOT_ENABLED=false
# HERMES_MODAL_FEISHU_INGRESS_MEMORY_SNAPSHOT_ENABLED=false
# HERMES_MODAL_FEISHU_ACK_REACTION_MEMORY_SNAPSHOT_ENABLED=false
# HERMES_MODAL_CHAT_QUEUE_MEMORY_SNAPSHOT_ENABLED=false
# HERMES_FEISHU_ACK_REACTION_INLINE_BUDGET_MS=600
# HERMES_FEISHU_ACK_REACTION_REQUEST_TIMEOUT_SECONDS=3.0
# HERMES_FEISHU_AGENT_MAX_ITERATIONS=12
# HERMES_FEISHU_AGENT_MAX_TOKENS=900
# HERMES_FEISHU_REASONING_EFFORT=none
# HERMES_FEISHU_RESPONSE_STYLE_PROMPT=
# HERMES_FEISHU_API_TIMEOUT=45
# HERMES_FEISHU_STREAM_READ_TIMEOUT=20
# HERMES_FEISHU_STREAM_STALE_TIMEOUT=25
# HERMES_FEISHU_FAIL_FAST_PROVIDER_ERRORS=true
# HERMES_FEISHU_INLINE_FIRST_RESPONSE_BUDGET_MS=2500
# HERMES_FEISHU_PROVIDER_FIRST_TOKEN_BUDGET_MS=1800
# HERMES_FEISHU_INLINE_WORKER_HARD_BUDGET_MS=4000
# HERMES_MODAL_FEISHU_BACKGROUND_EXEC_WORKER_MEMORY_MB=1536
# HERMES_MODAL_FEISHU_BACKGROUND_EXEC_WORKER_CPU=0.5
# HERMES_MODAL_CRON_QUEUE_MAX_JOBS_PER_WORKER=4
